{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/runner/*.js": {
      "regions": [
        "icn1"
      ],
      "maxDuration": 10,
      "includeFiles": "js/runner.js"
    },
    "api/mcp/[key].js": {
      "regions": [
        "icn1"
      ],
      "maxDuration": 60,
      "includeFiles": "{library/books/**,js/world.js,js/brain.js,js/shelf.js}"
    },
    "api/room.js": {
      "regions": [
        "icn1"
      ],
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/((?!runner/top).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
