{
 "name": "뽈뽈 문어 부엌 소리 (진짜 녹음 foley)",
 "version": 1,
 "generated": "2026-11-08",
 "about": "부엌 미니게임(해초전 등)에 쓰는 진짜 녹음 효과음. OpenGameArt 의 CC0 / CC-BY 녹음을 잘라 겹치고 크기를 맞췄다. 칩튠 한 벌(audio/manifest.json) 옆에 놓는 층이다. 출처와 바꾼 것은 CREDITS.md.",
 "base": "files 경로는 이 폴더(foley/) 기준이다. js/audio.js 가 앞에 foley/ 를 붙여 받는다. listen.html 도 이 폴더 기준 상대 경로.",
 "rules": {
  "formats": {
   "pick": "audio/manifest.json 과 같다: Opus(.ogg) 를 먼저, 못 읽으면 AAC(.m4a).",
   "sample_rate": 48000,
   "channels": 1
  },
  "loudness": {
   "reference": "BGM 통합 -20 LUFS. 모든 파일에 들려줄 크기가 구워져 있다(level.rel_db = BGM 대비). gain 1.0 으로 틀고 효과음 슬라이더만 곱한다.",
   "unit": "파일마다: 1.5 s 이상 = 통합 LUFS, 짧으면 소리 나는 구간 RMS. audio/src/export.py level() 의 코드와 audio/manifest.json 이 쓰는 경계다(그 파일 설명 글의 \"1초\" 는 코드와 다르다).",
   "short_term": "level.loudest_100ms_lufs / loudest_400ms_lufs = K 가중 가장 큰 100 ms / 400 ms. 단위가 달라도 들리는 크기를 견줄 수 있게 적었다(크기 맞춤에는 쓰지 않는다).",
   "true_peak": "-3 dBTP 아래"
  },
  "looping": {
   "how": "Web Audio AudioBufferSourceNode: loop=true, loopStart=loop.start, loopEnd=loop.end, 시작은 start(t, loop.start). <audio loop> 는 쓰지 않는다.",
   "pad": "파일 앞 0.5 s = 몸통 끝 복사, 뒤 1.0 s = 몸통 앞 복사(이음새용 여유).",
   "start": "루프는 처음과 끝에 0.25~1.0 s 페이드를 준다(몸통 한가운데서 시작하므로)."
  },
  "bus": "모두 sfx_event(효과음 슬라이더). 지글·보글 루프도 앞에 서는 요리 소리라 amb 가 아니다. duck_db 0: 한 번짜리 소리는 BGM 을 내리지 않는다. 대신 js/audio.js 가 부엌이 열려 있는 동안 음악을 내려 두고(BGM -6 dB, 환경음 -9 dB), 지글·보글 루프가 도는 동안은 더 내린다(BGM -10 dB, 환경음 -13 dB).",
  "sizzle_family": "cook_sizzle_0 -> 1 -> 2 는 같은 팬(같은 녹음 fryingpan01)이 달궈지는 세 결이다. 크기 -35/-32/-30 LUFS. 밝기(마스터 몸통의 스펙트럼 무게중심 9750/10393/10923 Hz, 8 kHz 위 에너지 몫 0.584/0.669/0.718)는 0 -> 1 -> 2 로 오른다. 도드라지는 탁탁(2 kHz 위 2 ms 창이 200 ms 이동 중앙값보다 +9 dB 솟는 곳)은 초당 2.41/0.22/5.7: 0 은 조용한 바탕에 성긴 탁탁, 1 은 이 녹음에서 가장 빽빽하고 고른 쉬익이라 탁탁이 쉬익에 묻혀 따로 솟는 것이 가장 적다(소리는 셋 중 가운데로 크다), 2 가 가장 바쁘다. 기름 튐(+15 dB 넘음)은 초당 0/0/0.2 (2 에만). 크기 흔들림(250 ms 크기의 표준편차)은 1.17/0.67/0.73 dB. 서로 상관없는 잡음이라 등전력(cos/sin) 크로스페이드가 맞다.",
  "durations": "duration 은 마스터(= .ogg 디코드) 길이다. .m4a 를 ffmpeg 로 디코드하면 AAC 의 마지막 1024 샘플 묶음이 남아 0.7~21 ms 더 길다(뒤는 디지털 무음). Chrome decodeAudioData 는 정확한 길이. 루프 지점과 뒤 여유에는 영향 없음.",
  "variation": "group 이 같은 변형은 직전과 다른 것. 시드 PRNG(Math.random 금지). 음높이는 +-15 센트까지.",
  "sound_off": "소리는 꺼진 채 시작하는 게임이라 이 층은 덤이다. 없거나 못 읽으면 조용히 건너뛴다."
 },
 "map": {
  "cook": {
   "_how": "AUDIO.on('cook', { act, ... }) 의 act -> 소리 group. group 이 같은 변형은 직전과 다른 것을 고른다(시드 PRNG). 음높이 흔들기는 +-15 센트까지.",
   "pick": "cook_pick",
   "tap": "cook_pat",
   "sizzle": {
    "_how": "band 0 이 불 켜기와 함께 처음 오면 cook_heat_on 한 번 + cook_sizzle_0 루프를 1.0 s 페이드인으로 시작. band 1, 2 가 오면 지금 루프에서 다음 루프로 0.15 s 등전력 크로스페이드 + 치익 한 번(새 루프가 +4 dB 까지 올랐다가 0.5 s 에 제 크기로: 그림의 기포 터짐과 같은 때 들리는 굽기 바뀜). 탭이 돌아와 같은 band 가 다시 오면(불이 켜진 채) heat_on 없이 그 루프만 0.3 s 페이드인.",
    "heat_on": "cook_heat_on",
    "0": "cook_sizzle_0",
    "1": "cook_sizzle_1",
    "2": "cook_sizzle_2"
   },
   "flip": {
    "_how": "flip 사건과 같은 때 cook_flip 을 그대로 튼다(늦추지 않는다): 파일 안의 철퍽 봉우리가 각 파일의 sync.land_s 에 와서 arc 3번째 그림(착지, 250~333 ms)과 맞는다. 그 앞은 휙. 움직임 줄이기(arc 없이 바로 바뀜)면 start(t, sync.reduced_motion_offset_s) 로 휙을 건너뛴다.",
    "id": "cook_flip"
   },
   "quiet": {
    "_how": "도는 지글/보글 루프를 0.25 s 페이드아웃 후 멈춘다(원샷은 그대로 끝까지). 파일은 없다."
   },
   "cut": "cook_cut",
   "step": "cook_step",
   "done": {
    "_how": "접시 공개: cook_plate. cook_plate 는 시작 17~22 ms 에 봉우리라 접시가 다 올라온 때(6 그림 x 83 ms 의 끝, 공개 뒤 약 0.42 s)에 틀면 \"탁 놓임\" 과 맞는다. cook_steam 은 고르면 그 0.15 s 뒤에 겹친다.",
    "plate": "cook_plate",
    "steam": "cook_steam"
   },
   "stir": "cook_stir",
   "clink": "cook_clink",
   "simmer": "cook_simmer",
   "place": "cook_place",
   "lift": "cook_lift",
   "back": {
    "_how": "lift 와 같은 결 더 작게: cook_lift 를 gain 0.5(-6 dB)로",
    "id": "cook_lift",
    "gain": 0.5
   }
  }
 },
